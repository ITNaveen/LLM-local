// ── SEND MESSAGE ──────────────────────────────────────────────────────────
async function sendMsg() {
  if (S.streaming) return;
  var inEl = document.getElementById("msg-in");
  var text = inEl.value.trim();
  var pendingCount = (window._pendingFiles && window._pendingFiles.length) || 0;
  // Count pasted/dropped files too — they live in _pendingFiles, not S.files
  if (!text && !S.files.length && !pendingCount) return;

  // Create chat if none
  if (!S.chatId) {
    var r = await api("/api/chats", "POST", {model: S.model, folder_id: S.pendingFolder});
    S.pendingFolder = null;
    S.chatId = r.id;
    document.getElementById("welcome").style.display = "none";
    document.getElementById("msgs").style.display    = "flex";
    document.getElementById("btn-close").classList.add("show");
    document.getElementById("chat-title").textContent = "New Chat";
  }

  renderMsg("user", text || "[files attached]");
  scrollBottom();
  inEl.value = ""; autoResize(inEl);
  var files = S.files.slice(); clearAttach();
  // Add pasted/dropped files
  if (window._pendingFiles && window._pendingFiles.length) {
    files = files.concat(window._pendingFiles);
    window._pendingFiles = [];
    updateFilePreview();
  }

  S.streaming = true;
  document.getElementById("btn-send").disabled = true;
  var thinkId = renderThink();

  try {
    var fd;
    if (files.length) {
      fd = new FormData();
      fd.append("message", text);
      fd.append("depth", S_DEPTH);            // manual depth tier (form field)
      files.forEach(function(f) { fd.append("files", f); });
    }
    var resp = await fetch("/api/chats/" + S.chatId + "/messages", {
      method: "POST",
      ...(fd ? {body: fd} : {headers: {"Content-Type": "application/json"}, body: JSON.stringify({message: text, depth: S_DEPTH})})
    });
    if (!resp.ok) {
      var err = {};
      try { err = await resp.json(); } catch(e) {}
      removeEl(thinkId);
      renderMsg("assistant", "error: " + (err.error || ("HTTP " + resp.status)));
      loadChats();   // keep sidebar in sync — never let a chat silently disappear
      return;
    }

    var reader  = resp.body.getReader();
    var decoder = new TextDecoder();
    var aId     = null;
    var buf     = "";

    removeEl(thinkId);

    while (true) {
      var chunk = await reader.read();
      if (chunk.done) break;
      buf += decoder.decode(chunk.value, {stream: true});
      var lines = buf.split("\n");
      buf = lines.pop();
      lines.forEach(function(line) {
        if (!line.startsWith("data:")) return;
        var raw = line.slice(5).trim();
        if (!raw) return;
        try {
          var evt = JSON.parse(raw);
          if (evt.type === "text") {
            if (!aId) {
              aId = renderMsg("assistant", "", 0, 0, true);
              streamAppend(aId, evt.text);   // include first chunk — was lost before
            } else {
              streamAppend(aId, evt.text);
            }
          } else if (evt.type === "memory_saved") {
            toast("💾 Saved to memory: " + (evt.preview || "").substring(0, 60) + "...");
          } else if (evt.type === "preference_saved") {
            toast("🧠 Learned preference: " + (evt.preview || "").substring(0, 70));
          } else if (evt.type === "done") {
            refreshStats();
            refreshSpend();
            loadChats();
            if (evt.cache_read) showCacheHit(evt.cache_read);
          } else if (evt.type === "error") {
            if (!aId) renderMsg("assistant", "error: " + evt.text);
          }
        } catch(e) {}
      });
    }
    if (aId) streamFinal(aId);

  } catch(err) {
    removeEl(thinkId);
    renderMsg("assistant", "error: " + err.message);
    loadChats();   // keep sidebar in sync on network/stream errors too
  } finally {
    S.streaming = false;
    document.getElementById("btn-send").disabled = false;
    document.getElementById("msg-in").focus();
  }
}

// ── RENDER ────────────────────────────────────────────────────────────────
function renderMsg(role, content, tin, tout, streaming) {
  var id  = "m" + (++S.msgN);
  var el  = document.createElement("div");
  el.className = "msg " + role;
  el.id        = id;
  var av  = role === "user" ? "N" : "L";
  var bub;
  if (role === "assistant") {
    var txt = typeof content === "string" ? content :
      (Array.isArray(content) ? content.map(function(b){return b.text||"";}).join("") : String(content));
    bub = renderMD(txt);
  } else {
    bub = esc(typeof content === "string" ? content : String(content));
  }
  var meta = (tin || tout) ? '<div class="msg-meta">' + tin + " in &middot; " + tout + " out</div>" : "";
  el.innerHTML = '<div class="msg-av">' + av + '</div><div class="msg-body"><div class="msg-bub" id="b' + id + '">' + bub + "</div>" + meta + "</div>";
  document.getElementById("msgs").appendChild(el);
  if (!streaming) bindCopy(el);
  scrollBottom();
  return id;
}

function renderThink() {
  var id = "t" + (++S.msgN);
  var el = document.createElement("div");
  el.className = "msg assistant"; el.id = id;
  el.innerHTML = '<div class="msg-av">L</div><div class="msg-body"><div class="msg-bub"><div class="thinking"><span></span><span></span><span></span></div></div></div>';
  document.getElementById("msgs").appendChild(el);
  scrollBottom();
  return id;
}

function streamAppend(id, text) {
  S.bufs[id] = (S.bufs[id] || "") + text;
  var el = document.getElementById("b" + id);
  if (el) { el.innerHTML = renderMD(S.bufs[id]) + '<span style="opacity:.4">|</span>'; scrollBottom(); }
}

function streamFinal(id) {
  var el = document.getElementById("b" + id);
  if (el && S.bufs[id]) {
    el.innerHTML = renderMD(S.bufs[id]);
    delete S.bufs[id];
    bindCopy(el);
  }
}

function bindCopy(container) {
  container.querySelectorAll(".copy-btn").forEach(function(btn) {
    btn.onclick = function() {
      navigator.clipboard.writeText(btn.closest("pre").querySelector("code").textContent).then(function() {
        btn.textContent = "Copied!"; btn.classList.add("done");
        setTimeout(function() { btn.textContent = "Copy"; btn.classList.remove("done"); }, 2000);
      });
    };
  });
}

function removeEl(id) { var el = document.getElementById(id); if (el) el.remove(); }

// ── MARKDOWN ──────────────────────────────────────────────────────────────
function renderMD(raw) {
  if (!raw) return "";
  var blocks = [];

  // 1. Fenced code blocks — extract before any other processing
  var text = raw.replace(/```(\w*)\n?([\s\S]*?)```/g, function(_, lang, code) {
    var l = lang || "text";
    var h = "<pre>" +
      '<div class="code-hdr"><span class="code-lang">' + l + "</span>" +
      '<button class="copy-btn" type="button">Copy</button></div>' +
      "<code>" + esc(code.replace(/\n$/, "")) + "</code></pre>";
    blocks.push(h); return "\x00" + (blocks.length-1) + "\x00";
  });

  // 2. Tables — must run BEFORE paragraph processing
  // Detects: line starts with |, has separator row (|---|), renders as <table>
  text = text.replace(
    /((?:^\|.+\|\s*\n)+)/gm,
    function(block) {
      var rows = block.trim().split("\n");
      if (rows.length < 2) return block;
      // Check for separator row (|---|---|)
      var sepIdx = -1;
      for (var i = 0; i < rows.length; i++) {
        if (/^\|[-:\s|]+\|\s*$/.test(rows[i])) { sepIdx = i; break; }
      }
      if (sepIdx === -1) return block;

      var html = '<div style="overflow-x:auto;margin:10px 0"><table>';

      // Header rows (before separator)
      if (sepIdx > 0) {
        html += "<thead>";
        for (var r = 0; r < sepIdx; r++) {
          var cells = rows[r].replace(/^\|/, "").replace(/\|$/, "").split("|");
          html += "<tr>";
          cells.forEach(function(c) { html += "<th>" + c.trim() + "</th>"; });
          html += "</tr>";
        }
        html += "</thead>";
      }

      // Body rows (after separator)
      html += "<tbody>";
      for (var r2 = sepIdx + 1; r2 < rows.length; r2++) {
        if (!rows[r2].trim()) continue;
        var cells2 = rows[r2].replace(/^\|/, "").replace(/\|$/, "").split("|");
        html += "<tr>";
        cells2.forEach(function(c2) {
          // Apply bold/inline-code within cells
          var cell = c2.trim()
            .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
            .replace(/`([^`]+)`/g, "<code>$1</code>");
          html += "<td>" + cell + "</td>";
        });
        html += "</tr>";
      }
      html += "</tbody></table></div>";
      blocks.push(html);
      return "\x00" + (blocks.length-1) + "\x00";
    }
  );

  // 3. Inline code
  text = text.replace(/`([^`\n]+)`/g, function(_, c) { return "<code>" + esc(c) + "</code>"; });

  // 4. Headers
  text = text.replace(/^### (.+)$/gm, "<h3>$1</h3>");
  text = text.replace(/^## (.+)$/gm,  "<h2>$1</h2>");
  text = text.replace(/^# (.+)$/gm,   "<h1>$1</h1>");

  // 5. Bold / italic
  text = text.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
  text = text.replace(/\*(.+?)\*/g,       "<em>$1</em>");

  // 6. Blockquote
  text = text.replace(/^> (.+)$/gm, "<blockquote>$1</blockquote>");

  // 7. HR
  text = text.replace(/^---+$/gm, "<hr/>");

  // 8. Lists
  text = text.replace(/^[ \t]*[-*] (.+)$/gm, "<li>$1</li>");
  text = text.replace(/^[ \t]*\d+\. (.+)$/gm, "<li>$1</li>");
  text = text.replace(/(<li>.*?<\/li>\n?)+/g, function(m) { return "<ul>" + m + "</ul>"; });

  // 9. Paragraphs
  var lines = text.split("\n"), out = "", inP = false;
  var BLOCK = /^(<h[1-6]|<ul|<ol|<pre|<hr|<blockquote|\x00)/;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    if (BLOCK.test(line)) {
      if (inP) { out += "</p>"; inP = false; }
      out += line + "\n";
    } else if (!line.trim()) {
      if (inP) { out += "</p>"; inP = false; }
    } else {
      if (!inP) { out += "<p>"; inP = true; } else out += " ";
      out += line;
    }
  }
  if (inP) out += "</p>";

  // 10. Restore code blocks and tables
  out = out.replace(/\x00(\d+)\x00/g, function(_, i) { return blocks[parseInt(i)]; });
  return out;
}

function esc(s) {
  if (typeof s !== "string") return "";
  return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

