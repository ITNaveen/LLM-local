      var title = it.title || it.source || "(untitled)";
      var meta;
      if (kbCurrentTab === "incidents") {
        meta = (it.symptoms || "").substring(0, 80);
      } else if (kbCurrentTab === "runbooks") {
        meta = (it.scenario || "").substring(0, 80);
      } else {
        meta = (it.source || "") + " · " + (it.len || 0) + " chars";
      }
      return '<div class="kb-item">'
        + '<button class="kb-item-del" onclick="kbDelete(\''+ it.id +'\')" title="Delete">✕</button>'
        + '<div class="kb-item-title">' + escapeHtml(title) + '</div>'
        + '<div class="kb-item-meta">' + escapeHtml(meta) + '</div>'
        + '</div>';
    }).join("");
  } catch(e) { listEl.innerHTML = '<div style="color:#ff6b6b">Load failed</div>'; }
}

function escapeHtml(s) {
  if (!s) return "";
  return String(s).replace(/[&<>"']/g, function(c) {
    return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
  });
}

