<script>
"use strict";
// ── STATE ─────────────────────────────────────────────────────────────────
var S = {
  chatId:      null,
  model:       "claude-sonnet-4-6",
  models:      [],
  files:       [],
  streaming:   false,
  sbOpen:      true,
  msgN:        0,
  bufs:        {},
  dbxOpen:     false,
  folders:     [],
  collapsedFolders: {},
  pendingFolder: null,
  dragChatId:  null,
  PURCHASED:   1000000,
  OFFSET:      72015,   // tokens used before this app (from console.anthropic.com)
};

// ── BOOT ──────────────────────────────────────────────────────────────────
async function boot() {
  await loadModels();
  await loadChats();
  await loadSettingsPreview();
  await refreshStats();
  await refreshSpend();
  await loadWSState();
  await loadDepthState();  // Load Normal/Average/Deep/Super depth choice
  kbStats();               // Load knowledge base item count
  await loadTheme();       // Apply saved light/dark theme
}

// ── MODELS ────────────────────────────────────────────────────────────────
async function loadModels() {
  var r = await fetch("/api/models");
  S.models = await r.json();
  renderModelDrop();
  renderModelSelect();
}

function renderModelDrop() {
  var el = document.getElementById("model-list");
  var groups = {};
  S.models.forEach(function(m) {
    if (!groups[m.group]) groups[m.group] = [];
    groups[m.group].push(m);
  });
  var html = "";
  Object.keys(groups).forEach(function(g) {
    html += '<div class="md-group">' + esc(g) + "</div>";
    groups[g].forEach(function(m) {
      var active = m.id === S.model ? " active" : "";
      var frTag  = m.free ? '<span class="md-free">FREE</span>' : "";
      html += '<div class="md-item' + active + '" onclick="modelSelect(\'' + m.id + '\')">';
      html += '<span class="md-name">' + esc(m.name) + "</span>" + frTag + "</div>";
    });
  });
  el.innerHTML = html;
  var sel = S.models.find(function(m) { return m.id === S.model; });
  if (sel) {
    document.getElementById("model-pill-lbl").textContent = sel.name;
    document.getElementById("model-foot").textContent = sel.free ? sel.name + " (FREE)" : sel.name;
  }
}

function renderModelSelect() {
  var sel = document.getElementById("s-model");
  sel.innerHTML = S.models.map(function(m) {
    return '<option value="' + m.id + '">' + m.name + (m.free ? " (FREE)" : "") + "</option>";
  }).join("");
}

function modelToggle() {
  document.getElementById("model-drop").classList.toggle("open");
}

document.addEventListener("click", function(e) {
  var dd = document.getElementById("model-drop");
  var pp = document.getElementById("model-pill");
  if (!dd.contains(e.target) && !pp.contains(e.target)) dd.classList.remove("open");
});

async function modelSelect(id) {
  S.model = id;
  document.getElementById("model-drop").classList.remove("open");
  renderModelDrop();
  if (S.chatId) {
    await api("/api/chats/" + S.chatId, "PATCH", {model: id});
  }
  toast(S.models.find(function(m){return m.id===id;})?.name || id);
}

// ── SIDEBAR ───────────────────────────────────────────────────────────────
function sbToggle() { S.sbOpen ? sbHide() : sbShow(); }
function sbShow() {
  S.sbOpen = true;
  document.getElementById("sidebar").classList.remove("hidden");
  document.getElementById("sb-tab").classList.remove("show");
  if (window.innerWidth <= 680) document.getElementById("mob-bg").classList.add("show");
}
function sbHide() {
  S.sbOpen = false;
  document.getElementById("sidebar").classList.add("hidden");
  document.getElementById("sb-tab").classList.add("show");
  document.getElementById("mob-bg").classList.remove("show");
}
function sbOpen() { sbShow(); }
function sbClose() { sbHide(); }

// ── CHAT LIST ─────────────────────────────────────────────────────────────
// Render a single chat row (unchanged markup — reused for folders + unfiled)
function _chatItemHtml(c, statusMap) {
  var active    = c.id === S.chatId ? " active" : "";
  var hasFolder = statusMap.hasOwnProperty(c.id) ? statusMap[c.id] : true;
  var dotClass  = hasFolder ? "green" : "grey";
  var dotTitle  = hasFolder ? "Active — folder exists on disk" : "No folder found on disk";
  var h = '<div class="cl-item' + active + '" draggable="true"' +
          ' ondragstart="chatDragStart(event,\'' + c.id + '\')"' +
          ' ondragend="chatDragEnd(event)"' +
          ' onclick="chatOpen(\'' + c.id + '\')" id="ci-' + c.id + '">';
  h += '<span class="cl-dot ' + dotClass + '" title="' + dotTitle + '"></span>';
  h += '<div class="cl-body"><div class="cl-title">' + esc(c.title) + "</div></div>";
  h += '<div class="cl-btns">';
  h += '<button class="cl-btn move" onclick="chatMovePrompt(event,\'' + c.id + '\')" title="Move to folder">&#128193;</button>';
  h += '<button class="cl-btn del" onclick="chatDel(event,\'' + c.id + '\')" title="Delete">&#10005;</button>';
  h += "</div></div>";
  return h;
}

async function loadChats() {
  var r    = await fetch("/api/chats");
  var list = await r.json();
  var el   = document.getElementById("chatlist");

  // Load folders (additive — empty list means behave exactly as before)
  try {
    var fr = await fetch("/api/folders");
    S.folders = await fr.json();
  } catch(e) { S.folders = []; }

  if (!list.length && !(S.folders && S.folders.length)) {
    el.innerHTML = '<div class="cl-section">No chats yet</div>';
    return;
  }

  // Fetch folder status for green/grey dots and orphan info
  var statusMap = {};
  var orphans   = [];
  try {
    var sr   = await fetch("/api/chats/status");
    var sd   = await sr.json();
    (sd.chats || []).forEach(function(cs) { statusMap[cs.chat_id] = cs.has_folder; });
    orphans = sd.orphan_folders || [];
  } catch(e) { /* status dots optional — don't break chat list */ }

  var html = "";

  // ── FOLDERS (rendered on top, collapsible) ──────────────────────────────
  if (S.folders && S.folders.length) {
    S.folders.forEach(function(f) {
      var fchats = list.filter(function(c){ return c.folder_id === f.id; });
      // Default COLLAPSED: a folder is open ONLY if explicitly toggled open (=== false)
      var collapsed = (S.collapsedFolders[f.id] === false) ? "" : " collapsed";
      html += '<div class="cl-folder' + collapsed + '" id="clf-' + f.id + '">';
      html += '<div class="cl-folder-hdr" onclick="folderToggle(\'' + f.id + '\')"' +
              ' ondragover="folderDragOver(event,\'' + f.id + '\')"' +
              ' ondragleave="folderDragLeave(event,\'' + f.id + '\')"' +
              ' ondrop="folderDrop(event,\'' + f.id + '\')">';
      html += '<span class="cl-folder-caret">&#9656;</span>';
      html += '<span class="cl-folder-icon">&#128193;</span>';
      html += '<span class="cl-folder-name">' + esc(f.name) + '</span>';
      html += '<span class="cl-folder-count">' + fchats.length + '</span>';
      html += '<button class="cl-btn fadd" onclick="newChatInFolder(event,\'' + f.id + '\')" title="New chat in this folder">+</button>';
      html += '<button class="cl-btn fdel" onclick="folderDel(event,\'' + f.id + '\')" title="Delete folder (chats become unfiled)">&#10005;</button>';
      html += '</div>';
      html += '<div class="cl-folder-body"' +
              ' ondragover="folderDragOver(event,\'' + f.id + '\')"' +
              ' ondragleave="folderDragLeave(event,\'' + f.id + '\')"' +
              ' ondrop="folderDrop(event,\'' + f.id + '\')">';
      if (fchats.length) {
        fchats.forEach(function(c){ html += _chatItemHtml(c, statusMap); });
      } else {
        html += '<div class="cl-folder-empty">Empty — drag a chat here</div>';
      }
      html += '</div></div>';
    });
  }

  // ── UNFILED CHATS (exact same time-grouping as before) ──────────────────
  var unfiled = list.filter(function(c){ return !c.folder_id; });
  var today   = new Date().toDateString();
  var weekAgo = new Date(Date.now() - 6 * 86400000);
  var groups  = {Today: [], "This Week": [], Older: []};
  unfiled.forEach(function(c) {
    var d = new Date(c.updated_at);
    if (d.toDateString() === today) groups.Today.push(c);
    else if (d > weekAgo)           groups["This Week"].push(c);
    else                            groups.Older.push(c);
  });
  // Unfiled drop-zone wrapper (drag a chat here to remove it from a folder)
  html += '<div id="unfiled-zone" ondragover="unfiledDragOver(event)" ondragleave="unfiledDragLeave(event)" ondrop="unfiledDrop(event)">';
  Object.keys(groups).forEach(function(lbl) {
    if (!groups[lbl].length) return;
    html += '<div class="cl-section">' + lbl + "</div>";
    groups[lbl].forEach(function(c){ html += _chatItemHtml(c, statusMap); });
  });
  html += '</div>';  // /unfiled-zone

  // Orphan folders section — folders on disk not linked to any DB chat
  if (orphans.length) {
    html += '<div class="cl-orphan-hdr"><span class="cl-dot red"></span>Orphan Folders (' + orphans.length + ')</div>';
    html += '<div style="font-size:10px;color:var(--text3);padding:0 8px 5px;line-height:1.5">These folders exist on disk but have no matching chat. You can delete them manually from Finder.</div>';
    orphans.forEach(function(name) {
      html += '<div class="cl-orphan-item">';
      html += '<span class="cl-dot red"></span>';
      html += '<div class="cl-body"><div class="cl-orphan-name">' + esc(name) + "</div></div>";
      html += "</div>";
    });
  }

  el.innerHTML = html;
  var si = document.getElementById("chat-search-input");
  if (si && si.value) filterChats(si.value);
}

// ── FOLDER UI ACTIONS ──────────────────────────────────────────────────────
function folderToggle(fid) {
  // Semantics: collapsedFolders[fid] === false => OPEN; anything else => COLLAPSED.
  var isOpen = (S.collapsedFolders[fid] === false);
  S.collapsedFolders[fid] = isOpen ? true : false;  // flip open<->collapsed
  loadChats();  // re-render keeps DOM in lockstep with state
}

async function folderCreate() {
  var name = prompt("New folder name:");
  if (!name || !name.trim()) return;
  await api("/api/folders", "POST", {name: name.trim()});
  await loadChats();
  toast("Folder created");
}

async function folderDel(ev, fid) {
  ev.stopPropagation();
  if (!confirm("Delete this folder? Its chats are kept and become unfiled.")) return;
  await api("/api/folders/" + fid, "DELETE");
  await loadChats();
  toast("Folder deleted — chats kept");
}

async function chatMovePrompt(ev, chatId) {
  ev.stopPropagation();
  var opts = ["0 — (Unfiled / remove from folder)"];
  (S.folders || []).forEach(function(f, i){ opts.push((i+1) + " — " + f.name); });
  var pick = prompt("Move chat to which folder?\n\n" + opts.join("\n") + "\n\nEnter the number:");
  if (pick === null) return;
  var idx = parseInt(pick.trim(), 10);
  var folder_id = null;
  if (idx >= 1 && idx <= (S.folders||[]).length) folder_id = S.folders[idx-1].id;
  await api("/api/chats/" + chatId + "/folder", "PATCH", {folder_id: folder_id});
  await loadChats();
  toast(folder_id ? "Moved to folder" : "Removed from folder");
}

// ── DRAG & DROP — move chats into folders ──────────────────────────────────
function chatDragStart(ev, chatId) {
  S.dragChatId = chatId;
  ev.dataTransfer.effectAllowed = "move";
  try { ev.dataTransfer.setData("text/plain", chatId); } catch(e){}
  var el = document.getElementById("ci-" + chatId);
  if (el) el.classList.add("dragging");
}
function chatDragEnd(ev) {
  S.dragChatId = null;
  document.querySelectorAll(".cl-item.dragging").forEach(function(el){ el.classList.remove("dragging"); });
  document.querySelectorAll(".cl-folder.drop-hot").forEach(function(el){ el.classList.remove("drop-hot"); });
}
function folderDragOver(ev, fid) {
  ev.preventDefault();              // required to allow drop
  ev.dataTransfer.dropEffect = "move";
  var f = document.getElementById("clf-" + fid);
  if (f) f.classList.add("drop-hot");
}
function folderDragLeave(ev, fid) {
  // Only clear when actually leaving the folder box (not moving between children)
  var f = document.getElementById("clf-" + fid);
  if (f && !f.contains(ev.relatedTarget)) f.classList.remove("drop-hot");
}
async function folderDrop(ev, fid) {
  ev.preventDefault();
  ev.stopPropagation();
  var f = document.getElementById("clf-" + fid);
  if (f) f.classList.remove("drop-hot");
  var chatId = S.dragChatId || (ev.dataTransfer && ev.dataTransfer.getData("text/plain"));
  S.dragChatId = null;
  if (!chatId) return;
  S.collapsedFolders[fid] = false;   // false = OPEN (expand to show moved chat)
  await api("/api/chats/" + chatId + "/folder", "PATCH", {folder_id: fid});
  await loadChats();
  toast("Moved to folder");
}
// Drop onto the "unfiled" area to pull a chat back out of a folder
function unfiledDragOver(ev) {
  ev.preventDefault();
  ev.dataTransfer.dropEffect = "move";
  var z = document.getElementById("unfiled-zone");
  if (z) z.classList.add("drop-hot");
}
function unfiledDragLeave(ev) {
  var z = document.getElementById("unfiled-zone");
  if (z && !z.contains(ev.relatedTarget)) z.classList.remove("drop-hot");
}
async function unfiledDrop(ev) {
  ev.preventDefault();
  var z = document.getElementById("unfiled-zone");
  if (z) z.classList.remove("drop-hot");
  var chatId = S.dragChatId || (ev.dataTransfer && ev.dataTransfer.getData("text/plain"));
  S.dragChatId = null;
  if (!chatId) return;
  await api("/api/chats/" + chatId + "/folder", "PATCH", {folder_id: null});
  await loadChats();
  toast("Removed from folder");
}

