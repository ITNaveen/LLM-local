<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover"/>
<meta name="theme-color" content="#0d0f14"/>
<title>LocalLLM</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS ───────────────────────────────────────────── */
:root {
  /* claude.ai light theme — cream background, dark readable text */
  --bg:       #ffffff;
  --bg2:      #f5f4ef;
  --bg3:      #eeece2;
  --border:   #e3e1d8;
  --border2:  #d4d1c4;
  --text:     #1f1e1c;
  --text2:    #5a574e;
  --text3:    #8a877d;
  --accent:   #c15f3c;
  --accentH:  #a84e2f;
  --green:    #2e8b57;
  --red:      #c0392b;
  --yellow:   #b8860b;
  --mono:     'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
  --sans:     -apple-system, 'Segoe UI', system-ui, 'Helvetica Neue', sans-serif;
  --sbw:      260px;
  --ease:     .15s ease;
}

/* ── DARK THEME — applied when <html data-theme="dark"> ──────────── */
html[data-theme="dark"] {
  --bg:       #1a1c22;
  --bg2:      #22252d;
  --bg3:      #2b2f39;
  --border:   #353a45;
  --border2:  #424857;
  --text:     #e8e6e0;
  --text2:    #a8a59c;
  --text3:    #6f6d66;
  --accent:   #d4744f;
  --accentH:  #e08862;
  --green:    #4caf7d;
  --red:      #e05545;
  --yellow:   #d4a437;
}

/* ── RESET ────────────────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;font-family:var(--sans);background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
button{cursor:pointer;border:none;background:none;font-family:inherit;color:inherit}
input,textarea,select{font-family:inherit;outline:none;color:var(--text)}
a{color:var(--accentH)}
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* ── LAYOUT ───────────────────────────────────────────── */
#app{display:flex;height:100vh;height:100dvh;overflow:hidden}

/* ── SIDEBAR ──────────────────────────────────────────── */
#sidebar{
  width:var(--sbw);min-width:var(--sbw);flex-shrink:0;
  background:var(--bg2);border-right:1px solid var(--border);
  display:flex;flex-direction:column;height:100vh;height:100dvh;
  transition:transform .25s ease;z-index:200;
}
#sidebar.hidden{transform:translateX(-100%)}

/* sidebar header */
#sbhead{
  padding:13px 11px 10px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:7px;flex-shrink:0;
}
#logo{display:flex;align-items:center;gap:8px;flex:1;font-size:15px;font-weight:600}
#logo .dot{
  width:28px;height:28px;border-radius:8px;flex-shrink:0;
  background:linear-gradient(135deg,var(--accent),var(--accentH));
  display:flex;align-items:center;justify-content:center;
  font-size:13px;font-weight:700;color:#fff;
}
.hbtn{
  width:30px;height:30px;border-radius:7px;
  background:var(--bg3);border:1px solid var(--border2);
  color:var(--text2);display:flex;align-items:center;justify-content:center;
  font-size:16px;transition:all var(--ease);flex-shrink:0;
}
.hbtn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}

/* token balance */
#tok-panel{
  padding:10px 10px 8px;border-bottom:1px solid var(--border);
  flex-shrink:0;
}
#tok-panel .label{
  font-size:9px;font-weight:700;color:var(--text3);
  text-transform:uppercase;letter-spacing:.8px;margin-bottom:7px;
}
#tok-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:5px}
.tok-card{
  background:var(--bg3);border-radius:9px;padding:9px 8px;text-align:center;
}
.tok-card.used{border:1px solid rgba(251,191,36,.2)}
.tok-card.left{border:1px solid rgba(62,207,142,.2)}
.tok-num{
  font-size:15px;font-weight:700;font-family:var(--mono);line-height:1;margin-bottom:3px;
}
.tok-card.used .tok-num{color:var(--yellow)}
.tok-card.left .tok-num{color:var(--green)}
.tok-sub{font-size:9px;color:var(--text3)}
#tok-note{font-size:9px;color:var(--text3);text-align:center}

/* chat list */
#chatlist{flex:1 1 auto;min-height:60px;overflow-y:auto;padding:6px 7px}
.cl-section{
  font-size:10px;font-weight:600;color:var(--text3);
  text-transform:uppercase;letter-spacing:.8px;
  padding:9px 8px 3px;
}
.cl-item{
  padding:8px 9px;border-radius:8px;cursor:pointer;
  display:flex;align-items:center;gap:7px;
  transition:background var(--ease);margin-bottom:1px;
  border:1px solid transparent;
}
.cl-item:hover{background:var(--bg3)}
.cl-item.active{background:var(--bg3);border-color:var(--border2)}
.cl-icon{font-size:12px;flex-shrink:0;opacity:.45}
.cl-body{flex:1;min-width:0}
.cl-title{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
.cl-meta{font-size:10px;color:var(--text3);margin-top:1px}
.cl-btns{display:flex;gap:2px;opacity:0;transition:opacity var(--ease)}
.cl-item:hover .cl-btns{opacity:1}
.cl-btn{
  width:22px;height:22px;border-radius:5px;font-size:12px;color:var(--text3);
  display:flex;align-items:center;justify-content:center;transition:all .1s;
}
.cl-btn:hover{background:var(--border2);color:var(--text)}
.cl-btn.del:hover{background:var(--red);color:#fff}
.cl-btn.move:hover{background:var(--accent);color:#fff}

/* ── FOLDERS ──────────────────────────────────────────── */
.cl-folder{margin:2px 0 4px}
.cl-folder-hdr{
  display:flex;align-items:center;gap:6px;
  padding:7px 8px;border-radius:7px;cursor:pointer;
  transition:background var(--ease);user-select:none;
}
.cl-folder-hdr:hover{background:var(--bg3)}
.cl-folder-caret{
  font-size:10px;color:var(--text3);flex-shrink:0;
  transition:transform var(--ease);transform:rotate(90deg);
}
.cl-folder.collapsed .cl-folder-caret{transform:rotate(0deg)}
.cl-folder-icon{font-size:13px;flex-shrink:0;opacity:.7}
.cl-folder-name{
  flex:1;min-width:0;font-size:12.5px;font-weight:600;color:var(--text2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  text-transform:uppercase;letter-spacing:.4px;
}
.cl-folder-count{
  font-size:10px;color:var(--text3);background:var(--bg3);
  border-radius:10px;padding:1px 7px;flex-shrink:0;
}
.cl-folder-hdr .fdel,
.cl-folder-hdr .fadd{
  width:20px;height:20px;border-radius:5px;font-size:13px;color:var(--text3);
  display:none;align-items:center;justify-content:center;transition:all .1s;flex-shrink:0;
}
.cl-folder-hdr:hover .fdel,
.cl-folder-hdr:hover .fadd{display:flex}
.cl-folder-hdr .fdel:hover{background:var(--red);color:#fff}
.cl-folder-hdr .fadd:hover{background:var(--accent);color:#fff}
.cl-folder-body{padding-left:10px;border-left:1px solid var(--border);margin-left:13px}
.cl-folder.collapsed .cl-folder-body{display:none}
.cl-folder-empty{font-size:11px;color:var(--text3);padding:6px 8px;font-style:italic}

/* Drag & drop visual feedback */
.cl-item{cursor:grab}
.cl-item.dragging{opacity:.45;cursor:grabbing}
.cl-folder.drop-hot > .cl-folder-hdr{
  background:var(--accent);color:#fff;
  box-shadow:0 0 0 2px var(--accent) inset;border-radius:7px;
}
.cl-folder.drop-hot > .cl-folder-hdr .cl-folder-name,
.cl-folder.drop-hot > .cl-folder-hdr .cl-folder-caret,
.cl-folder.drop-hot > .cl-folder-hdr .cl-folder-icon{color:#fff}
.cl-folder.drop-hot .cl-folder-body{background:rgba(217,119,87,.06);border-radius:6px}
#unfiled-zone.drop-hot{
  outline:2px dashed var(--accent);outline-offset:-2px;border-radius:8px;
  background:rgba(217,119,87,.05);
}
#unfiled-zone{min-height:40px;transition:background .1s}

/* sidebar footer */
#sbfoot{padding:8px 7px;border-top:1px solid var(--border);flex-shrink:0;max-height:70vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.sb-btn{
  width:100%;padding:8px 11px;border-radius:8px;
  display:flex;align-items:center;gap:8px;
  color:var(--text2);font-size:13px;transition:all var(--ease);
}
.sb-btn:hover{background:var(--bg3);color:var(--text)}
.sb-btn svg{opacity:.6;flex-shrink:0}

/* dropbox panel */
#dbx-panel{display:none;padding:0 7px 8px}
#dbx-panel.open{display:block}
#dbx-zone{
  border:2px dashed var(--border2);border-radius:9px;
  padding:18px 10px;text-align:center;cursor:pointer;
  transition:all var(--ease);margin-bottom:7px;background:var(--bg3);
}
#dbx-zone:hover,#dbx-zone.over{border-color:var(--green);background:rgba(62,207,142,.06)}
#dbx-zone-icon{font-size:20px;margin-bottom:5px}
#dbx-zone-txt{font-size:11px;color:var(--text2);line-height:1.5}
#dbx-zone-txt span{color:var(--accentH);text-decoration:underline}
#dbx-status{font-size:10px;color:var(--text3);text-align:center;margin-bottom:4px}
#dbx-status.ok{color:var(--green)}
#dbx-status.err{color:var(--red)}
#dbx-list{display:none}
.dbx-item{
  display:flex;align-items:center;gap:6px;padding:5px 6px;
  border-radius:6px;margin-bottom:2px;font-size:11px;
  background:var(--bg3);border:1px solid var(--border);
}
.dbx-icon{font-size:13px;flex-shrink:0}
.dbx-info{flex:1;min-width:0}
.dbx-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text)}
.dbx-meta{font-size:10px;color:var(--text3);margin-top:1px}
.dbx-del{
  width:18px;height:18px;border-radius:3px;color:var(--text3);
  font-size:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.dbx-del:hover{background:var(--red);color:#fff}
#dbx-path{font-size:9px;color:var(--text3);text-align:center;margin-top:4px;font-family:var(--mono);word-break:break-all}

/* ── MAIN ─────────────────────────────────────────────── */
#main{flex:1;display:flex;flex-direction:column;min-width:0;height:100vh;height:100dvh;overflow:hidden}

/* topbar */
#topbar{
  padding:10px 16px;border-bottom:1px solid var(--border);
  display:flex;align-items:center;gap:10px;
  background:var(--bg);flex-shrink:0;min-height:50px;
}
#btn-toggle{
  display:none;
  width:30px;height:30px;border-radius:7px;
  background:var(--bg3);border:1px solid var(--border2);
  color:var(--text2);font-size:16px;display:flex;align-items:center;justify-content:center;
  transition:all var(--ease);flex-shrink:0;
}
#btn-toggle:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
#title-area{flex:1;min-width:0;display:flex;align-items:center;gap:6px}
#chat-title{
  font-size:14px;font-weight:500;color:var(--text);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  cursor:pointer;padding:3px 6px;border-radius:5px;transition:background var(--ease);
}
#chat-title:hover{background:var(--bg3)}
#title-edit{
  font-size:14px;font-weight:500;flex:1;
  background:var(--bg3);border:1px solid var(--accent);
  border-radius:6px;padding:3px 9px;display:none;
}
#btn-close{
  width:26px;height:26px;border-radius:6px;flex-shrink:0;
  color:var(--text3);font-size:14px;
  display:none;align-items:center;justify-content:center;
  transition:all var(--ease);
}
#btn-close.show{display:flex}
#btn-close:hover{background:var(--red);color:#fff}

/* model pill */
#model-pill{
  display:flex;align-items:center;gap:5px;
  padding:5px 10px;border-radius:8px;
  background:var(--bg3);border:1px solid var(--border2);
  cursor:pointer;transition:all var(--ease);flex-shrink:0;
  max-width:130px;
}
#model-pill:hover{border-color:var(--accent)}
#spend-pill{
  display:flex;align-items:center;gap:5px;
  padding:8px 12px;border-radius:8px;
  background:var(--bg2);border:1px solid var(--border);
  font-size:12px;font-weight:600;color:var(--green);
  white-space:nowrap;flex-shrink:0;cursor:default;
  font-variant-numeric:tabular-nums;
}
#spend-pill-lbl{color:var(--green)}
#model-pill-lbl{
  font-size:12px;color:var(--text2);font-weight:500;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}

/* model dropdown */
#model-drop{
  position:fixed;top:52px;right:16px;width:300px;
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:12px;box-shadow:0 12px 48px rgba(0,0,0,.6);
  z-index:1000;display:none;max-height:75vh;overflow-y:auto;
}
#model-drop.open{display:block}
.md-group{
  font-size:10px;font-weight:600;color:var(--text3);
  text-transform:uppercase;letter-spacing:.9px;
  padding:10px 14px 3px;
  position:sticky;top:0;background:var(--bg2);
}
.md-item{
  padding:10px 14px;display:flex;align-items:center;
  justify-content:space-between;cursor:pointer;
  transition:background .1s;
}
.md-item:hover{background:var(--bg3)}
.md-item.active{background:rgba(92,110,245,.1)}
.md-name{font-size:13px;font-weight:500;color:var(--text)}
.md-free{
  font-size:9px;font-weight:600;padding:1px 5px;border-radius:3px;
  background:rgba(62,207,142,.12);color:var(--green);
  border:1px solid rgba(62,207,142,.2);flex-shrink:0;
}

/* ── MESSAGES ─────────────────────────────────────────── */
#msgs-wrap{flex:1;overflow-y:auto;padding:16px 0;scroll-behavior:smooth}
#msgs{max-width:960px;margin:0 auto;padding:0 18px;display:flex;flex-direction:column;gap:18px}

/* welcome */
#welcome{
  max-width:960px;margin:0 auto;padding:60px 18px 20px;
  display:flex;flex-direction:column;align-items:center;text-align:center;
}
#welcome-logo{
  width:54px;height:54px;border-radius:14px;
  background:linear-gradient(135deg,var(--accent),var(--accentH));
  display:flex;align-items:center;justify-content:center;
  font-size:25px;font-weight:700;color:#fff;margin-bottom:16px;
  box-shadow:0 8px 28px rgba(92,110,245,.3);
}
#welcome h1{font-size:21px;font-weight:600;margin-bottom:7px}
#welcome p{font-size:13px;color:var(--text2);line-height:1.65}

/* messages */
.msg{display:flex;gap:10px;align-items:flex-start}
.msg.user{flex-direction:row-reverse}
.msg-av{
  width:28px;height:28px;border-radius:7px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;
}
.msg.user .msg-av{background:var(--accent);color:#fff}
.msg.assistant .msg-av{background:var(--bg3);color:var(--text2);border:1px solid var(--border2)}
.msg-body{max-width:880px;min-width:0}
.msg.user .msg-body{text-align:right}
.msg-bub{
  display:inline-block;padding:10px 14px;border-radius:12px;
  font-size:14px;line-height:1.65;text-align:left;word-break:break-word;
}
.msg.user .msg-bub{background:var(--accent);color:#fff;border-radius:12px 12px 3px 12px}
.msg.assistant .msg-bub{
  background:var(--bg2);border:1px solid var(--border);
  border-radius:12px 12px 12px 3px;color:var(--text);width:100%;
}
.msg-meta{font-size:10px;color:var(--text3);margin-top:3px;padding:0 3px}

/* markdown */
.msg-bub p{margin:0 0 9px}
.msg-bub p:last-child{margin-bottom:0}
.msg-bub h1{font-size:17px;font-weight:600;margin:12px 0 5px}
.msg-bub h2{font-size:15px;font-weight:600;margin:10px 0 4px}
.msg-bub h3{font-size:14px;font-weight:600;margin:8px 0 3px}
.msg-bub ul,.msg-bub ol{padding-left:18px;margin:6px 0}
.msg-bub li{margin:2px 0;font-size:14px}
.msg-bub code{background:#eeece2!important;color:#a84e2f!important;font-family:var(--mono);font-size:12.5px;background:rgba(255,255,255,.08);padding:1px 5px;border-radius:4px;color:#c9d1ff}
.msg-bub pre{background:#f5f4ef!important;border:1px solid #e3e1d8!important;color:#1f1e1c!important;background:#090b10;border:1px solid var(--border2);border-radius:8px;overflow-x:auto;margin:9px 0}
.code-hdr{display:flex;align-items:center;justify-content:space-between;padding:5px 12px;border-bottom:1px solid var(--border);background:#0d1017;border-radius:8px 8px 0 0}
.code-lang{font-size:10px;color:var(--text3);font-family:var(--mono);text-transform:uppercase;font-weight:600}
.copy-btn{font-size:11px;color:var(--text3);padding:2px 7px;border-radius:4px;border:1px solid var(--border2);transition:all .1s}
.copy-btn:hover{background:var(--bg3);color:var(--text)}
.copy-btn.done{color:var(--green);border-color:rgba(62,207,142,.3)}
.msg-bub pre code{display:block;padding:12px 14px;background:transparent;font-size:12.5px;line-height:1.6;color:#c5cde8;white-space:pre}
.msg-bub strong{color:var(--text);font-weight:600}
.msg-bub em{color:var(--text2)}
.msg-bub blockquote{border-left:3px solid var(--accent);padding:5px 11px;margin:7px 0;background:rgba(92,110,245,.07);border-radius:0 5px 5px 0;color:var(--text2)}
.msg-bub table{border-collapse:collapse;width:100%;margin:12px 0;font-size:13px;overflow-x:auto;display:block}
.msg-bub th,.msg-bub td{border:1px solid var(--border2);padding:7px 14px;text-align:left;white-space:nowrap}
.msg-bub th{background:var(--bg3);font-weight:600;color:var(--text);border-bottom:2px solid var(--accent)}
.msg-bub tr:nth-child(even){background:rgba(255,255,255,.02)}
.msg-bub tr:hover td{background:rgba(92,110,245,.05)}
.msg-bub hr{border:none;border-top:1px solid var(--border);margin:10px 0}

/* thinking */
.thinking{display:flex;gap:4px;align-items:center;padding:4px 0}
.thinking span{width:6px;height:6px;border-radius:50%;background:var(--accent);animation:think .9s infinite}
.thinking span:nth-child(2){animation-delay:.2s}
.thinking span:nth-child(3){animation-delay:.4s}
@keyframes think{0%,80%,100%{opacity:.2;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}

/* ── INPUT ────────────────────────────────────────────── */
#input-wrap{padding:10px 18px 12px;border-top:1px solid var(--border);flex-shrink:0;background:var(--bg)}
#input-box{
  max-width:960px;margin:0 auto;
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:12px;overflow:hidden;transition:border-color var(--ease);
}
#input-box:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px rgba(92,110,245,.08)}
#attach-prev{padding:8px 11px 0;display:none;flex-wrap:wrap;gap:5px}
#attach-prev.has{display:flex}
.ach{
  display:flex;align-items:center;gap:4px;padding:3px 8px;border-radius:5px;
  background:var(--bg3);border:1px solid var(--border2);font-size:11px;color:var(--text2);
}
.ach button{color:var(--text3);font-size:12px;width:14px;height:14px;display:flex;align-items:center;justify-content:center}
.ach button:hover{background:var(--red);color:#fff;border-radius:2px}
#input-row{display:flex;align-items:flex-end;gap:5px;padding:8px 10px}
#btn-attach{
  width:30px;height:30px;border-radius:6px;flex-shrink:0;color:var(--text3);font-size:17px;
  display:flex;align-items:center;justify-content:center;transition:all var(--ease);
}
#btn-attach:hover{background:var(--bg3);color:var(--text)}
#file-in{display:none}
#msg-in{
  flex:1;background:transparent;border:none;color:var(--text);
  font-size:14px;line-height:1.55;resize:none;
  min-height:22px;max-height:180px;padding:3px 0;overflow-y:auto;
}
#msg-in::placeholder{color:var(--text3)}
#btn-send{
  width:32px;height:32px;border-radius:8px;flex-shrink:0;
  background:var(--accent);color:#fff;font-size:14px;
  display:flex;align-items:center;justify-content:center;
  transition:all var(--ease);
}
#btn-send:hover:not(:disabled){background:var(--accentH);transform:scale(1.06)}
#btn-send:disabled{opacity:.35;cursor:not-allowed;transform:none}
#input-foot{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 12px 8px;font-size:10px;color:var(--text3);
}

/* ── MODALS ───────────────────────────────────────────── */
#overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(4px);z-index:500;display:none}
#overlay.open{display:block}
#settings-modal{
  position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
  width:min(510px,94vw);background:var(--bg2);
  border:1px solid var(--border2);border-radius:14px;
  box-shadow:0 24px 80px rgba(0,0,0,.7);z-index:501;
  display:none;max-height:90vh;overflow-y:auto;
}
#settings-modal.open{display:block}
.mhdr{padding:16px 20px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.mhdr-title{font-size:15px;font-weight:600}
.mhdr-close{width:27px;height:27px;border-radius:5px;color:var(--text3);font-size:16px;display:flex;align-items:center;justify-content:center;transition:all var(--ease)}
.mhdr-close:hover{background:var(--bg3);color:var(--text)}
.mbody{padding:18px 20px}
.fg{margin-bottom:15px}
.flabel{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--text2);margin-bottom:6px}
.fbadge{font-size:9px;padding:1px 5px;border-radius:3px;font-weight:600}
.fbadge.paid{background:rgba(92,110,245,.15);color:var(--accentH)}
.fbadge.free{background:rgba(62,207,142,.12);color:var(--green)}
.finput{
  width:100%;padding:9px 12px;border-radius:8px;
  background:var(--bg3);border:1px solid var(--border2);
  font-size:12.5px;font-family:var(--mono);transition:border-color var(--ease);
}
.finput:focus{border-color:var(--accent)}
.fhint{font-size:11px;color:var(--text3);margin-top:4px;line-height:1.5}
.fselect{width:100%;padding:9px 12px;border-radius:8px;background:var(--bg3);border:1px solid var(--border2);font-size:12.5px;cursor:pointer}
.btn-save{width:100%;padding:11px;border-radius:8px;background:var(--accent);color:#fff;font-size:13px;font-weight:500;transition:all var(--ease)}
.btn-save:hover{background:var(--accentH)}
.div{height:1px;background:var(--border);margin:16px 0}
.stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}
.stat-card{background:var(--bg3);border:1px solid var(--border);border-radius:7px;padding:10px 7px;text-align:center}
.stat-val{font-size:16px;font-weight:600;color:var(--accentH);font-family:var(--mono)}
.stat-lbl{font-size:10px;color:var(--text3);margin-top:2px}

/* ── MOBILE ───────────────────────────────────────────── */
#mob-bg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:199;display:none}
#mob-bg.show{display:block}
#sb-tab{
  position:fixed;left:0;top:50%;transform:translateY(-50%);
  width:16px;height:48px;background:var(--bg2);
  border:1px solid var(--border2);border-left:none;
  border-radius:0 6px 6px 0;z-index:201;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  color:var(--text3);font-size:10px;transition:all var(--ease);
  opacity:0;pointer-events:none;
}
#sb-tab.show{opacity:1;pointer-events:all}
#sb-tab:hover{width:20px;background:var(--bg3);color:var(--text)}

@media(max-width:680px){
  /* Sidebar slides over content, full height */
  #sidebar{position:fixed;left:0;top:0;bottom:0;height:100dvh;width:84vw;min-width:84vw;max-width:320px;z-index:300;padding-top:env(safe-area-inset-top)}
  /* Stray side-tab arrow removed on mobile — hamburger button handles it */
  #sb-tab{display:none!important}

  /* Topbar — bigger tap targets + notch safe-area */
  #topbar{padding:8px 10px;gap:8px;padding-top:calc(8px + env(safe-area-inset-top))}
  #btn-toggle{display:flex!important;width:40px;height:40px;font-size:20px}
  #chat-title{font-size:15px}
  #model-pill{max-width:110px;padding:7px 10px}
  #spend-pill{padding:7px 9px;font-size:11px}
  #model-pill-lbl{font-size:12px}
  #btn-discover{width:34px;height:34px}
  #model-drop{right:8px;left:8px;width:auto;top:56px}

  /* Messages — full width, readable */
  #msgs{padding:0 12px;max-width:100%}
  .msg-body{max-width:100%}
  .msg-bub{font-size:15px;line-height:1.55}
  .msg-bub pre{background:#f5f4ef!important;border:1px solid #e3e1d8!important;color:#1f1e1c!important;font-size:12.5px}
  .msg-bub table{font-size:12px}

  /* Welcome screen smaller + less dead space */
  #welcome{padding:30px 16px 16px;justify-content:center;min-height:60%}
  #welcome h1{font-size:24px}
  #welcome p{font-size:13px}
  /* iOS momentum scrolling */
  #msgs-wrap{-webkit-overflow-scrolling:touch}

  /* Input area — bigger, easier to tap */
  #input-wrap{padding:8px 10px calc(10px + env(safe-area-inset-bottom))}
  #input-box{padding:8px 10px}
  #input-box textarea{font-size:16px}  /* 16px prevents iOS zoom on focus */
  #btn-send{width:44px;height:44px}
  #btn-mic{width:40px;height:40px}
  #btn-attach{width:40px;height:40px}

  /* Footer controls — bigger checkboxes and toggles */
  #input-foot{font-size:12px;flex-wrap:wrap;gap:6px}
  #input-foot > div{flex-wrap:wrap;gap:8px}
  .mode-btn{padding:7px 14px;font-size:12px}
  #ws-tog{transform:scale(1.3);margin-right:2px}
  #ws-lbl{font-size:12px}

  /* Stats grid 2-col */
  .stat-grid{grid-template-columns:1fr 1fr}

  /* Credit balance boxes bigger text */
  .tok-num{font-size:16px}

  /* Touch devices have no hover — always show chat + folder action buttons */
  .cl-btns{opacity:1}
  .cl-folder-hdr .fdel,
  .cl-folder-hdr .fadd{display:flex}

  /* File preview wraps */
  #file-preview{padding:6px 10px 0}
}

@media(min-width:681px){
  #mob-bg{display:none!important}
  #btn-toggle{display:none}
}

/* ── TOAST ────────────────────────────────────────────── */
#toast{
  position:fixed;bottom:70px;left:50%;transform:translateX(-50%);
  background:var(--bg3);border:1px solid var(--border2);color:var(--text);
  padding:8px 18px;border-radius:20px;font-size:12.5px;
  z-index:9999;opacity:0;transition:opacity .2s;pointer-events:none;white-space:nowrap;
}
#toast.show{opacity:1}

/* ── CHAT STATUS DOTS ─────────────────────────────────────────── */
.cl-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
  margin-right: 1px;
}
.cl-dot.green  { background: var(--green);  box-shadow: 0 0 4px rgba(62,207,142,.5); }
.cl-dot.red    { background: var(--red);    box-shadow: 0 0 4px rgba(248,113,113,.5); }
.cl-dot.grey   { background: var(--text3);  }

/* ── ORPHAN SECTION ───────────────────────────────────────────── */
.cl-orphan-hdr {
  font-size: 10px; font-weight: 600; color: var(--red);
  text-transform: uppercase; letter-spacing: .8px;
  padding: 9px 8px 3px; display: flex; align-items: center; gap: 5px;
}
.cl-orphan-item {
  padding: 6px 9px; border-radius: 8px;
  display: flex; align-items: center; gap: 7px;
  margin-bottom: 1px; border: 1px solid rgba(248,113,113,.2);
  background: rgba(248,113,113,.04);
}
.cl-orphan-name {
  flex: 1; font-size: 11px; color: var(--text2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  font-family: var(--mono);
}
.cl-orphan-hint { font-size: 10px; color: var(--text3); margin-top: 1px; }


/* ══════════════════════════════════════════════════════════════════
   TOKEN OPTIMISATION UI
   - Response mode toggle (Concise / Detailed)
   - Cache indicator in message meta
   - Snapshot modal
   ══════════════════════════════════════════════════════════════════ */

/* ── Response mode toggle pill ── */
#mode-toggle {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--bg3);
  border: 1px solid var(--border2);
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.mode-btn {
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 600;
  color: var(--text3);
  border-radius: 0;
  transition: all .12s;
  cursor: pointer;
  border: none;
  background: none;
  font-family: var(--sans);
}
.mode-btn.active {
  background: var(--accent);
  color: #fff;
}
.mode-btn:hover:not(.active) {
  background: var(--border2);
  color: var(--text);
}
#depth-toggle {
  display: flex;
  align-items: center;
  gap: 0;
  background: var(--bg3);
  border: 1px solid var(--border2);
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.depth-btn {
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 600;
  color: var(--text3);
  border-radius: 0;
  transition: all .12s;
  cursor: pointer;
  border: none;
  background: none;
  font-family: var(--sans);
  border-right: 1px solid var(--border2);
}
.depth-btn:last-child { border-right: none; }
.depth-btn.active { background: var(--accent); color: #fff; }
.depth-btn:hover:not(.active) { background: var(--border2); color: var(--text); }

/* ── Cache hit indicator on message meta ── */
.cache-hit {
  color: var(--green);
  font-size: 9px;
  margin-left: 5px;
  opacity: .7;
}

/* ── Snapshot modal ── */
#snap-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.65);
  backdrop-filter: blur(4px);
  z-index: 600;
  display: none;
}
#snap-overlay.open { display: block; }

#snap-modal {
  position: fixed;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: min(460px, 93vw);
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: 14px;
  box-shadow: 0 24px 80px rgba(0,0,0,.7);
  z-index: 601;
  display: none;
  padding: 20px;
}
#snap-modal.open { display: block; }

#snap-modal h3 {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 5px;
  color: var(--text);
}
#snap-modal p {
  font-size: 11px;
  color: var(--text2);
  margin-bottom: 14px;
  line-height: 1.55;
}
#snap-label {
  width: 100%;
  padding: 9px 12px;
  border-radius: 8px;
  background: var(--bg3);
  border: 1px solid var(--border2);
  font-size: 13px;
  color: var(--text);
  margin-bottom: 12px;
}
#snap-label:focus { border-color: var(--accent); outline: none; }
#snap-status {
  font-size: 11px;
  min-height: 16px;
  margin-bottom: 10px;
  color: var(--text3);
}
#snap-status.ok  { color: var(--green); }
#snap-status.err { color: var(--red);   }
.snap-btns { display: flex; gap: 8px; }
#snap-save {
  flex: 1; padding: 9px;
  background: var(--accent); color: #fff;
  border-radius: 8px; font-size: 13px; font-weight: 500;
  border: none; cursor: pointer; transition: background .12s;
}
#snap-save:hover { background: var(--accentH); }
#snap-cancel {
  padding: 9px 14px;
  background: var(--bg3); color: var(--text2);
  border-radius: 8px; font-size: 13px;
  border: 1px solid var(--border2); cursor: pointer;
}
/* ─────────────────────────────────────────────────────────────── */


/* ══════════════════════════════════════════════════════════════════
   VOICE INPUT — ChatGPT-style mic button + recording states
   ══════════════════════════════════════════════════════════════════ */
#btn-mic {
  width: 30px; height: 30px; border-radius: 6px; flex-shrink: 0;
  color: var(--text3); font-size: 15px;
  display: flex; align-items: center; justify-content: center;
  transition: all var(--ease); position: relative;
}
#btn-mic:hover { background: var(--bg3); color: var(--text); }
#btn-mic.recording {
  color: var(--red); background: rgba(248,113,113,.12);
}
#btn-mic.recording::after {
  content: ''; position: absolute; inset: -3px; border-radius: 9px;
  border: 2px solid var(--red);
  animation: v-pulse 1.2s ease-in-out infinite;
}
@keyframes v-pulse {
  0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(1.08)}
}
#btn-mic.transcribing {
  color: var(--accent); background: rgba(92,110,245,.1); pointer-events: none;
}
#btn-mic.transcribing svg { animation: v-spin .9s linear infinite; }
@keyframes v-spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
#v-preview {
  display: none; align-items: center; gap: 6px;
  padding: 5px 11px;
  background: rgba(92,110,245,.08);
  border-top: 1px solid rgba(92,110,245,.15);
  font-size: 11px; color: var(--text2); line-height: 1.45;
}
#v-preview.show { display: flex; }
#v-preview-lbl { flex:1; font-style:italic; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#v-preview-lang { font-size:10px; color:var(--text3); flex-shrink:0; font-family:var(--mono); }


/* ── Chat search ── */
#chat-search{
  padding:5px 7px;
}
#chat-search input{
  width:100%;padding:6px 10px;border-radius:7px;
  background:var(--bg3);border:1px solid var(--border2);
  font-size:11px;color:var(--text);outline:none;
  font-family:var(--sans);
}
#chat-search input:focus{border-color:var(--accent)}
#chat-search input::placeholder{color:var(--text3)}

/* ── Model discover ── */
.discover-btn{
  padding:8px 12px;border-radius:8px;font-size:12px;
  background:var(--bg3);border:1px solid var(--border2);
  color:var(--text2);cursor:pointer;width:100%;text-align:left;
  transition:all .15s;margin-top:8px;
}
.discover-btn:hover{border-color:var(--accent);color:var(--text)}
#discover-list{margin-top:6px;max-height:200px;overflow-y:auto}
.disc-item{
  display:flex;align-items:center;gap:8px;padding:5px 8px;
  border-radius:6px;margin-bottom:2px;font-size:11px;
}
.disc-item:hover{background:var(--bg3)}
.disc-item .disc-name{flex:1;color:var(--text)}
.disc-item .disc-exists{color:var(--green);font-size:10px}
.disc-item .disc-add{
  padding:2px 8px;border-radius:4px;font-size:10px;
  background:var(--accent);color:#fff;border:none;cursor:pointer;
}
.disc-item .disc-add:hover{background:var(--accentH)}
#discover-status{font-size:10px;color:var(--text3);margin-top:4px}


/* ── Model Discover Button + Modal ── */
#btn-discover{
  width:28px;height:28px;border-radius:6px;flex-shrink:0;
  color:var(--text3);font-size:12px;font-weight:700;
  display:flex;align-items:center;justify-content:center;
  transition:all .15s;cursor:pointer;border:1px solid var(--border2);
  background:var(--bg3);font-family:var(--mono);
}
#btn-discover:hover{border-color:var(--accent);color:var(--accent);background:rgba(92,110,245,.1)}

#disc-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.6);
  backdrop-filter:blur(3px);z-index:700;display:none;
}
#disc-overlay.open{display:block}
#disc-modal{
  position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
  width:min(500px,92vw);max-height:80vh;overflow-y:auto;
  background:var(--bg2);border:1px solid var(--border2);
  border-radius:14px;box-shadow:0 24px 80px rgba(0,0,0,.7);
  z-index:701;display:none;padding:20px;
}
#disc-modal.open{display:block}
#disc-modal h3{font-size:14px;margin-bottom:12px;color:var(--text)}
.disc-tabs{display:flex;gap:0;margin-bottom:12px;background:var(--bg3);border-radius:7px;overflow:hidden}
.disc-tab{
  flex:1;padding:7px;text-align:center;font-size:11px;font-weight:600;
  cursor:pointer;color:var(--text3);transition:all .12s;border:none;background:none;
}
.disc-tab.active{background:var(--accent);color:#fff}
.disc-tab:hover:not(.active){background:var(--border2);color:var(--text)}
#disc-content{min-height:100px}
.disc-row{
  display:flex;align-items:center;gap:8px;padding:7px 8px;
  border-radius:7px;margin-bottom:2px;
}
.disc-row:hover{background:var(--bg3)}
.disc-name{flex:1;font-size:12px;color:var(--text)}
.disc-id{font-size:9px;color:var(--text3);font-family:var(--mono)}
.disc-badge{font-size:9px;color:var(--green);font-weight:600}
.disc-btn-add{
  padding:3px 10px;border-radius:5px;font-size:10px;font-weight:600;
  background:var(--accent);color:#fff;border:none;cursor:pointer;
}
.disc-btn-add:hover{background:var(--accentH)}
.disc-btn-del{
  padding:3px 10px;border-radius:5px;font-size:10px;font-weight:600;
  background:rgba(248,113,113,.15);color:var(--red);border:1px solid rgba(248,113,113,.3);cursor:pointer;
}
.disc-btn-del:hover{background:rgba(248,113,113,.25)}
#disc-status{font-size:10px;color:var(--text3);margin-bottom:8px;min-height:14px}


/* ── Paste/drop file preview ── */
#file-preview{background:var(--bg3);border-radius:8px;margin:0 8px}
.fp-item{display:flex;align-items:center;gap:5px;background:var(--bg2);
  border:1px solid var(--border2);border-radius:6px;padding:3px 8px;
  font-size:11px;color:var(--text2)}
.fp-item button{background:none;border:none;color:var(--text3);
  cursor:pointer;font-size:13px;padding:0 2px}
.fp-item button:hover{color:var(--red)}


/* Knowledge base panel */
.kb-tab {
  flex: 1;
  padding: 5px 8px;
  background: var(--bg3);
  border: 1px solid var(--border2);
  border-radius: 6px;
  font-size: 11px;
  color: var(--text2);
  cursor: pointer;
  transition: all .12s;
  font-family: var(--sans);
}
.kb-tab:hover { background: var(--border2); color: var(--text); }
.kb-tab-active { background: var(--accent); color: #fff; border-color: var(--accent); }
.kb-form { display: flex; flex-direction: column; gap: 5px; }
.kb-input, .kb-textarea {
  width: 100%;
  background: var(--bg3);
  border: 1px solid var(--border2);
  border-radius: 6px;
  padding: 6px 9px;
  font-size: 12px;
  color: var(--text);
  font-family: var(--sans);
  resize: vertical;
}
.kb-input:focus, .kb-textarea:focus { outline: none; border-color: var(--accent); }
.kb-save-btn {
  background: var(--accent);
  color: #fff;
  border-radius: 7px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  border: none;
}
.kb-save-btn:hover { filter: brightness(1.1); }
.kb-item {
  background: var(--bg3);
  border: 1px solid var(--border2);
  border-radius: 6px;
  padding: 6px 8px;
  margin-bottom: 5px;
  font-size: 11px;
}
.kb-item-title { font-weight: 600; color: var(--text); margin-bottom: 2px; }
.kb-item-meta { color: var(--text3); font-size: 10px; }
.kb-item-del {
  float: right;
  background: none;
  color: var(--text3);
  font-size: 11px;
  cursor: pointer;
  border: none;
  padding: 0 4px;
}
.kb-item-del:hover { color: #ff6b6b; }

</style>
</head>
<body>

<div id="mob-bg" onclick="sbClose()"></div>
<div id="sb-tab" onclick="sbOpen()">&#9654;</div>
<div id="overlay" onclick="settingsClose()"></div>

<div id="app">

  <!-- ══ SIDEBAR ══════════════════════════════════════ -->
  <div id="sidebar">

    <!-- header -->
    <div id="sbhead">
      <div id="logo"><div class="dot">L</div>LocalLLM</div>
      <button class="hbtn" onclick="newChat()" title="New chat">+</button>
      <button class="hbtn" onclick="folderCreate()" title="New folder">&#128193;</button>
      <button class="hbtn" onclick="sbToggle()" title="Collapse">&#8592;</button>
    </div>

    <!-- token balance -->
    <div id="tok-panel">
      <div class="label">Credit Balance</div>
      <div id="tok-grid">
        <div class="tok-card left" style="grid-column:1/-1">
          <div class="tok-num" id="tok-left" style="font-size:26px">—</div>
          <div class="tok-sub">Remaining Credit</div>
        </div>
      </div>
      <div id="tok-note">updates after each reply &middot; <a href="https://console.anthropic.com/settings/billing" target="_blank" style="color:var(--accent)">Anthropic Console</a></div>
    </div>

    <!-- chat list -->
    <div id="chat-search">
      <input type="text" id="chat-search-input" placeholder="&#128269; Search chats..." oninput="filterChats(this.value)"/>
    </div>
    <div id="chatlist"></div>

    <!-- footer -->
    <div id="sbfoot">

      <!-- dropbox -->
      <button class="sb-btn" id="dbx-toggle" onclick="dbxToggle()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        LLM Dropbox
      </button>

      <div id="dbx-panel">
        <div id="dbx-zone"
          ondragover="dbxOver(event)" ondragleave="dbxLeave(event)"
          ondrop="dbxDrop(event)" onclick="document.getElementById('dbx-in').click()">
          <div id="dbx-zone-icon">&#128228;</div>
          <div id="dbx-zone-txt">Drop any file here<br/><span>or tap to browse</span></div>
        </div>
        <input type="file" id="dbx-in" multiple onchange="dbxFiles(event)"/>
        <div id="dbx-status"></div>
        <div id="dbx-list"></div>
