// ── Cache hit indicator ─────────────────────────────────────────────────────
// Patches the "done" SSE event handler to show ⚡ when cache_read > 0.
// This tells you the history cache saved tokens on that request.
var _origStreamDone = null;  // handled inline in sendMsg patch below

// Patch sendMsg to display cache indicator
var _origSendMsg = sendMsg;
sendMsg = async function() {
  // We override the "done" event processing to show cache info.
  // This is done by wrapping the internal SSE loop — see inline patch marker below.
  await _origSendMsg.apply(this, arguments);
};

// The cache_read field arrives in the SSE "done" event.
// We inject it into the last assistant message's meta line.
var _lastAssistantMsgId = null;

// Patch streamFinal to record the last msg id
var _origStreamFinal = streamFinal;
streamFinal = function(id) {
  _lastAssistantMsgId = id;
  _origStreamFinal(id);
};

// Hook into the SSE "done" handler — cache indicator
function showCacheHit(cacheRead) {
  if (!cacheRead || cacheRead === 0) return;
  if (!_lastAssistantMsgId) return;
  var el = document.getElementById(_lastAssistantMsgId);
  if (!el) return;
  var meta = el.querySelector(".msg-meta");
  if (!meta) {
    // Add meta if missing
    var body = el.querySelector(".msg-body");
    if (body) {
      var m = document.createElement("div");
      m.className = "msg-meta";
      body.appendChild(m);
      meta = m;
    }
  }
  if (meta) {
    meta.innerHTML = (meta.innerHTML || "") +
      '<span class="cache-hit" title="' + cacheRead.toLocaleString() + ' tokens read from cache (90% discount)">&#9889; cached</span>';
  }
}

