// ══════════════════════════════════════════════════════════════════════════════
//  TOKEN OPTIMISATION MODULE
//
//  1. Response Mode toggle (Concise / Detailed)
//     Concise = max 600 output tokens — quick answers use far fewer tokens
//     Detailed = max 4096 output tokens — full deep answers (default)
//
//  2. Project Snapshot
//     Saves a dense technical summary of ANY chat to Memory.
//     In a new chat, the snapshot is auto-injected into context.
//     Use for long projects (Nexus, Keycloak, K8s) that span multiple chats.
//
//  3. Cache hit indicator
//     When the server returns cache_read > 0, the message shows a green
//     ⚡ cache hit label so you know tokens were saved on that turn.
// ══════════════════════════════════════════════════════════════════════════════

// ── Response Mode ──────────────────────────────────────────────────────────
// Current depth choice — sent with every message. Default: average.
var S_DEPTH = "average";
var DEPTH_TIERS = ["normal", "average", "deep", "super"];
var DEPTH_LABELS = {
  normal:  "Normal — ~1,500 tokens (quick facts, syntax, one-liners)",
  average: "Average — ~4,500 tokens (your daily driver: troubleshooting, concept + why). Covers ~93% of your work.",
  deep:    "Deep — ~10,000 tokens (full breakdowns, ticket work, well above your all-time max)",
  super:   "Super — ~64,000 tokens (broken production, massive RCA. Never truncates.)"
};

function paintDepth() {
  DEPTH_TIERS.forEach(function(t) {
    var el = document.getElementById("depth-" + t);
    if (el) el.classList.toggle("active", t === S_DEPTH);
  });
}

async function setDepth(tier) {
  if (DEPTH_TIERS.indexOf(tier) === -1) return;
  S_DEPTH = tier;          // stays here until you change it (no reset per message)
  paintDepth();
  try {
    await fetch("/api/settings", {
      method:  "POST",
      headers: {"Content-Type": "application/json"},
      body:    JSON.stringify({depth_choice: tier}),
    });
  } catch(e) {}
  toast(DEPTH_LABELS[tier]);
}

async function loadDepthState() {
  try {
    var r = await fetch("/api/settings");
    var s = await r.json();
    S_DEPTH = s.depth_choice || "average";
  } catch(e) { S_DEPTH = "average"; }
  paintDepth();
}

// ── Snapshot modal ──────────────────────────────────────────────────────────
function snapOpen() {
  if (!S.chatId) { toast("Open a chat first"); return; }
  document.getElementById("snap-label").value  = "";
  document.getElementById("snap-status").textContent = "";
  document.getElementById("snap-status").className   = "";
  document.getElementById("snap-modal").classList.add("open");
  document.getElementById("snap-overlay").classList.add("open");
  setTimeout(function() { document.getElementById("snap-label").focus(); }, 100);
}

function snapClose() {
  document.getElementById("snap-modal").classList.remove("open");
  document.getElementById("snap-overlay").classList.remove("open");
}

async function snapSave() {
  var label = document.getElementById("snap-label").value.trim();
  if (!label) {
    document.getElementById("snap-status").textContent = "Please enter a label first";
    document.getElementById("snap-status").className   = "err";
    return;
  }

  var statusEl = document.getElementById("snap-status");
  statusEl.textContent = "Generating snapshot…";
  statusEl.className   = "";
  document.getElementById("snap-save").disabled = true;

  try {
    var r = await fetch("/api/chats/" + S.chatId + "/snapshot", {
      method:  "POST",
      headers: {"Content-Type": "application/json"},
      body:    JSON.stringify({label: label}),
    });
    var d = await r.json();

    if (d.error) {
      statusEl.textContent = "Error: " + d.error;
      statusEl.className   = "err";
      return;
    }

    statusEl.textContent = "✓ Saved to Memory — " + d.chars + " chars. Available in all future chats.";
    statusEl.className   = "ok";

    // Refresh memory panel if open
    if (typeof memLoad === "function") memLoad();

    // Auto-close after 2.5s
    setTimeout(function() {
      snapClose();
      toast("Snapshot saved: " + label);
    }, 2500);

  } catch(err) {
    statusEl.textContent = "Failed: " + err.message;
    statusEl.className   = "err";
  } finally {
    document.getElementById("snap-save").disabled = false;
  }
}

// Allow Enter key in snapshot label field
document.addEventListener("DOMContentLoaded", function() {
  var inp = document.getElementById("snap-label");
  if (inp) inp.addEventListener("keydown", function(e) {
    if (e.key === "Enter") snapSave();
    if (e.key === "Escape") snapClose();
  });
});

