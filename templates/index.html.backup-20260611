// ══════════════════════════════════════════════════════════════════════════════
//  VOICE INPUT MODULE
//  Press mic → speak → release → see transcript → press send
//  Token cost: ZERO — transcription runs locally via faster-whisper on M4
// ══════════════════════════════════════════════════════════════════════════════
var Voice = (function () {
  var _recorder = null, _chunks = [], _stream = null;
  var _isRecording = false, _isTranscribing = false;

  function _btn()      { return document.getElementById("btn-mic"); }
  function _micIcon()  { return document.getElementById("mic-icon"); }
  function _preview()  { return document.getElementById("v-preview"); }
  function _prevLbl()  { return document.getElementById("v-preview-lbl"); }
  function _prevLang() { return document.getElementById("v-preview-lang"); }
  function _textarea() { return document.getElementById("msg-in"); }

  var ICON_MIC = [
    '<path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>',
    '<path d="M19 10v2a7 7 0 0 1-14 0v-2"/>',
    '<line x1="12" y1="19" x2="12" y2="23"/>',
    '<line x1="8"  y1="23" x2="16" y2="23"/>',
  ].join("");
  var ICON_STOP = '<rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>';
  var ICON_SPIN = [
    '<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83"/>',
    '<path d="M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>',
  ].join("");

  function _setIcon(p) { var ic = _micIcon(); if (ic) ic.innerHTML = p; }

  function _setState(state) {
    var btn = _btn(); if (!btn) return;
    btn.classList.remove("recording", "transcribing");
    if (state === "idle")         { _setIcon(ICON_MIC);  btn.title = "Voice input — click to speak"; }
    else if (state === "recording")    { btn.classList.add("recording");    _setIcon(ICON_STOP); btn.title = "Recording… click to stop"; }
    else if (state === "transcribing") { btn.classList.add("transcribing"); _setIcon(ICON_SPIN); btn.title = "Transcribing…"; }
  }

  function _showPreview(text, lang) {
    var p = _preview(), l = _prevLbl(), g = _prevLang();
    if (!p || !l || !g) return;
    if (text) { l.textContent = text; g.textContent = lang ? "(" + lang + ")" : ""; p.classList.add("show"); }
    else       { p.classList.remove("show"); l.textContent = ""; g.textContent = ""; }
  }

  async function _startRecording() {
    try {
      _stream = await navigator.mediaDevices.getUserMedia({
        audio: { sampleRate: 16000, channelCount: 1,
                 echoCancellation: true, noiseSuppression: true, autoGainControl: true }
      });
    } catch(err) {
      toast(err.name === "NotAllowedError" ? "Mic permission denied — allow in browser settings" : "Mic error: " + err.message);
      return false;
    }
    _chunks = []; _isRecording = true;
    var mime = "audio/webm;codecs=opus";
    if (!MediaRecorder.isTypeSupported(mime)) mime = "audio/webm";
    if (!MediaRecorder.isTypeSupported(mime)) mime = "";
    _recorder = new MediaRecorder(_stream, mime ? {mimeType: mime} : {});
    _recorder.ondataavailable = function(e) { if (e.data && e.data.size > 0) _chunks.push(e.data); };
    _recorder.onstop = function() { _isRecording = false; _transcribe(); };
    _recorder.start(100);
    _setState("recording");
    return true;
  }

  function _stopRecording() {
    if (_recorder && _recorder.state !== "inactive") _recorder.stop();
    if (_stream) { _stream.getTracks().forEach(function(t){t.stop();}); _stream = null; }
    _setState("transcribing");
  }

  async function _transcribe() {
    if (!_chunks.length) { _setState("idle"); toast("No audio captured"); return; }
    _isTranscribing = true;
    var mime = (_recorder && _recorder.mimeType) ? _recorder.mimeType : "audio/webm";
    var blob = new Blob(_chunks, {type: mime}); _chunks = [];
    if (blob.size < 1000) { _setState("idle"); _isTranscribing = false; toast("Too short — speak for at least 1 second"); return; }
    try {
      var fd = new FormData(); fd.append("audio", blob, "recording.webm");
      var resp = await fetch("/api/voice/transcribe", {method: "POST", body: fd});
      var data = await resp.json();
      if (data.error) { toast("Transcription error: " + data.error); _setState("idle"); return; }
      var text = (data.text || "").trim();
      if (!text) { toast("No speech detected — try again"); _setState("idle"); return; }
      var ta = _textarea();
      if (ta) {
        var existing = ta.value.trim();
        ta.value = existing ? existing + " " + text : text;
        autoResize(ta); ta.focus();
        ta.selectionStart = ta.selectionEnd = ta.value.length;
      }
      _showPreview(text, data.language);
      var hideTimer = setTimeout(function(){ _showPreview("",""); }, 4000);
      if (ta) ta.addEventListener("input", function onI(){ clearTimeout(hideTimer); _showPreview("",""); ta.removeEventListener("input",onI); });
    } catch(err) {
      toast("Voice failed: " + err.message);
    } finally {
      _isTranscribing = false;
      _setState("idle");
    }
  }

  async function toggle() {
    if (_isTranscribing) return;
    if (_isRecording) _stopRecording(); else await _startRecording();
  }

  return { toggle: toggle };
})();

function voiceToggle() { Voice.toggle(); }
// ── End Voice Input Module ─────────────────────────────────────────────────


// ══════════════════════════════════════════════════════════════════════════════
//  CHAT SEARCH — filters chat list by title as you type
// ══════════════════════════════════════════════════════════════════════════════
function filterChats(query) {
  var q     = (query || "").toLowerCase().trim();
  var items = document.querySelectorAll(".cl-item");
  var sects = document.querySelectorAll(".cl-section");

  if (!q) {
    // Show everything
    items.forEach(function(el) { el.style.display = ""; });
    sects.forEach(function(el) { el.style.display = ""; });
    return;
  }

  // Hide non-matching items
  items.forEach(function(el) {
    var title = (el.querySelector(".cl-title") || {}).textContent || "";
    el.style.display = title.toLowerCase().includes(q) ? "" : "none";
  });

  // Hide section headers if all items in that section are hidden
  sects.forEach(function(sect) {
    var next = sect.nextElementSibling;
    var anyVisible = false;
    while (next && !next.classList.contains("cl-section")) {
      if (next.classList.contains("cl-item") && next.style.display !== "none") {
        anyVisible = true;
      }
      next = next.nextElementSibling;
    }
    sect.style.display = anyVisible ? "" : "none";
  });
}

// ══════════════════════════════════════════════════════════════════════════════
//  MODEL MANAGER — discover new models + remove old ones via D button
// ══════════════════════════════════════════════════════════════════════════════
var _discTab = "current";

function discOpen()  {
  document.getElementById("disc-overlay").classList.add("open");
  document.getElementById("disc-modal").classList.add("open");
  discTab(_discTab);
}
function discClose() {
  document.getElementById("disc-overlay").classList.remove("open");
  document.getElementById("disc-modal").classList.remove("open");
}

function discTab(tab) {
  _discTab = tab;
  document.getElementById("disc-tab-current").classList.toggle("active", tab === "current");
  document.getElementById("disc-tab-discover").classList.toggle("active", tab === "discover");
  document.getElementById("disc-status").textContent = "";
  if (tab === "current") discShowCurrent();
  else discShowDiscover();
}

async function discShowCurrent() {
  var el = document.getElementById("disc-content");
  try {
    var r = await fetch("/api/models");
    var models = await r.json();
    if (!models.length) { el.innerHTML = "No models configured"; return; }
    var h = "";
    models.forEach(function(m) {
      h += '<div class="disc-row">';
      h += '<div style="flex:1"><div class="disc-name">' + esc(m.name) + '</div>';
      h += '<div class="disc-id">' + esc(m.id) + '</div></div>';
      h += '<button class="disc-btn-del" onclick="discRemove(\'' + esc(m.id) + '\',\'' + esc(m.name) + '\')">Remove</button>';
      h += '</div>';
    });
    el.innerHTML = h;
  } catch(e) { el.innerHTML = "Error loading models"; }
}

async function discShowDiscover() {
  var el = document.getElementById("disc-content");
  var st = document.getElementById("disc-status");
  st.textContent = "Searching Anthropic API...";
  el.innerHTML   = "";
  try {
    var r = await fetch("/api/models/discover", {method: "POST"});
    var d = await r.json();
    if (d.error) { st.textContent = "Error: " + d.error; return; }
    st.textContent = d.models.length + " models found, " + d.new_count + " new";
    var h = "";
    d.models.forEach(function(m) {
      h += '<div class="disc-row">';
      h += '<div style="flex:1"><div class="disc-name">' + esc(m.name || m.id) + '</div>';
      h += '<div class="disc-id">' + esc(m.id) + '</div></div>';
      if (m.exists) {
        h += '<span class="disc-badge">✓ installed</span>';
      } else {
        h += '<button class="disc-btn-add" onclick="discAdd(\'' + esc(m.id) + '\',\'' + esc(m.name || m.id) + '\')">+ Add</button>';
      }
      h += '</div>';
    });
    el.innerHTML = h;
  } catch(e) { st.textContent = "Failed: " + e.message; }
}

async function discAdd(id, name) {
  try {
    var r = await fetch("/api/models/add", {
      method: "POST", headers: {"Content-Type": "application/json"},
      body: JSON.stringify({id: id, name: name})
    });
    var d = await r.json();
    if (d.error) { toast("Error: " + d.error); return; }
    toast("Added: " + name);
    await loadModels();
    discShowDiscover();
  } catch(e) { toast("Failed: " + e.message); }
}

async function discRemove(id, name) {
  if (!confirm("Remove " + name + " from your models?")) return;
  try {
    var r = await fetch("/api/models/remove", {
      method: "POST", headers: {"Content-Type": "application/json"},
      body: JSON.stringify({id: id})
    });
    var d = await r.json();
    if (d.error) { toast("Error: " + d.error); return; }
    toast("Removed: " + name);
    await loadModels();
    discShowCurrent();
  } catch(e) { toast("Failed: " + e.message); }
}


// ══════════════════════════════════════════════════════════════════════════
//  PASTE & DRAG-DROP IMAGE SUPPORT
//  Cmd+V / Ctrl+V paste screenshot directly into chat
//  Drag image file onto chat window to attach it
// ══════════════════════════════════════════════════════════════════════════

// Paste from clipboard (Ctrl+V / Cmd+V)
document.addEventListener("paste", function(e) {
  var items = (e.clipboardData || e.originalEvent.clipboardData).items;
  var imageItems = [];
  for (var i = 0; i < items.length; i++) {
    if (items[i].type.indexOf("image") !== -1) {
      imageItems.push(items[i].getAsFile());
    }
  }
  if (!imageItems.length) return;
  e.preventDefault();
  imageItems.forEach(function(file) {
    // Give it a meaningful name with timestamp
    var ts = new Date().toISOString().replace(/[:.]/g, "-").slice(0, 19);
    var named = new File([file], "screenshot-" + ts + ".png", {type: file.type});
    addPendingFile(named);
  });
  toast("📋 Screenshot pasted — press Send to attach");
});

// Drag and drop onto the chat area
var msgsWrap = document.getElementById("msgs-wrap");
if (msgsWrap) {
  msgsWrap.addEventListener("dragover", function(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = "copy";
    msgsWrap.style.outline = "2px dashed var(--accent)";
  });
  msgsWrap.addEventListener("dragleave", function() {
    msgsWrap.style.outline = "";
  });
  msgsWrap.addEventListener("drop", function(e) {
    e.preventDefault();
    msgsWrap.style.outline = "";
    var files = Array.from(e.dataTransfer.files);
    if (!files.length) return;
    files.forEach(function(f) { addPendingFile(f); });
    toast("📎 " + files.length + " file(s) dropped — press Send to attach");
  });
}

// addPendingFile: adds file to the pending attachments list
// Works with the existing file attachment system
function addPendingFile(file) {
  if (!window._pendingFiles) window._pendingFiles = [];
  window._pendingFiles.push(file);
  updateFilePreview();
}

function updateFilePreview() {
  var files = window._pendingFiles || [];
  var preview = document.getElementById("file-preview");
  if (!preview) return;
  if (!files.length) { preview.style.display = "none"; preview.innerHTML = ""; return; }
  preview.style.display = "flex";
  preview.innerHTML = files.map(function(f, i) {
    var isImg = f.type.startsWith("image/");
    var icon  = isImg ? "🖼" : "📎";
    return '<div class="fp-item">' +
      icon + ' <span>' + f.name + '</span>' +
      '<button onclick="removePendingFile(' + i + ')">×</button>' +
      '</div>';
  }).join("");
}

function removePendingFile(idx) {
  if (window._pendingFiles) window._pendingFiles.splice(idx, 1);
  updateFilePreview();
}

boot();
</script>

